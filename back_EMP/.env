# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#nextcloud
NEXTCLOUD_ENABLED=true
NEXTCLOUD_BASE_URL=http://localhost:8080
NEXTCLOUD_USERNAME=admin
NEXTCLOUD_PASSWORD=admin123
NEXTCLOUD_UPLOAD_ROOT=EMP-SmartOCR
NEXTCLOUD_TIMEOUT_SECONDS=20
NEXTCLOUD_VERIFY_SSL=false

#paddleocr
# OCR routing
OCR_ENGINE_PRIMARY=paddle
OCR_ENABLE_PADDLE_FALLBACK=true
OCR_ENABLE_TESSERACT_FALLBACK=true
OCR_ENABLE_PPSTRUCTURE=true
OCR_CONFIDENCE_THRESHOLD=0.62
OCR_PADDLE_LANG=en
OCR_PADDLE_LANG_FALLBACK=fr
OCR_DEBUG_ZONES=true
OCR_DEBUG_SAVE_DIR=./ocr_debug_crops
# Sauvetages par marque (FAB, Rhinestahl, CL101…) — laisser false (backend 100 % neutre)
OCR_ENABLE_BRAND_RESCUES=false

# Partie 1 — qualité document (avertissements dans la réponse API)
OCR_MIN_PAGE_WIDTH=1200
OCR_MIN_PAGE_HEIGHT=1600
OCR_MIN_ESTIMATED_DPI=200
OCR_MIN_BLUR_SCORE=35
OCR_QUALITY_STRICT=false
OCR_QUALITY_BLOCK_ON_FAIL=false

# Partie 6 — pré-traitement + OCR cellules bandeau haut
OCR_PREPROCESS_ENHANCE=true
OCR_ENABLE_HEADER_CELL_OCR=true